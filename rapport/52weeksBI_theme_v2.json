            "fontFamily": "Segoe UI Semibold",
            "fontSize": 14
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#B4C6EE"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1B3470"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#B4C6EE"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1B3470"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#B4C6EE"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
