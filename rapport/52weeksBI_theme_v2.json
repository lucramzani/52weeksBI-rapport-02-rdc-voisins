    "#1665D8",
    "#FF8A5B",
    "#F2C14E",
    "#2FBF8F",
    "#B4C6EE"
  ],
  "background": "#0C1E4A",
  "foreground": "#FFFFFF",
  "tableAccent": "#1665D8",
  "secondaryBackground": "#0C1E4A",
